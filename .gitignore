# ========================================================
# EduFlow ERP — Git Ignore Configuration
# ========================================================

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Django Databases (SQLite local testing databases)
*.sqlite3
*.sqlite3-journal
backend/*.sqlite3
eduflow_control.sqlite3
eduflow_tenant_demo.sqlite3

# Django Collected Static Files & Media Uploads
backend/staticfiles/
staticfiles/
backend/media/*
!backend/media/.gitkeep
!backend/media/avatars/
backend/media/avatars/*
!backend/media/avatars/.gitkeep
media/

# Pytest & Testing Cache
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Node.js & Frontend ---
node_modules/
**/node_modules/
frontend/dist/
dist/
**/dist/
.next/
**/.next/
out/
**/out/

# NPM / Yarn / Vite logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Credentials ---
# Never commit credentials or local overrides to source control!
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
frontend/.env.local
!*.env.example
!.env.example

# --- Reference / Temporary Directories ---
EduFlow frontend needs/
.gemini/
.system_generated/
scratch/
