# ========================================================
# EduFlow ERP — Unified Docker / Deployment Environment
# ========================================================

# Backend Service
DJANGO_SECRET_KEY=generate-a-secure-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# PostgreSQL Credentials
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=eduflow_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CONTROL_DB_NAME=eduflow_control
DEMO_TENANT_DB_NAME=eduflow_tenant_demo
USE_POSTGRES=true

# Frontend Service
VITE_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
