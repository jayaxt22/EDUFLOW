# ========================================================
# EduFlow ERP — Backend Production / Staging Environment
# ========================================================

# Django Core
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# Database Connection (PostgreSQL for Production)
DB_ENGINE=postgresql
USE_POSTGRES=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
CONTROL_DB_NAME=eduflow_control
DEMO_TENANT_DB_NAME=eduflow_tenant_demo

# For SQLite Local Testing (Set USE_POSTGRES=false)
# USE_POSTGRES=false

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.yourdomain.com
